<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20260519T183909" id="14a9ca02-e3f3-44ee-b58b-60d73c78dc99"/>

  <Content>
    <Paragraph Type="Action" id="eee3f704-ffef-4111-a664-732e42174308">
      <Text>DISTANCE DOESN'T MATTER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bd706fec-cef4-4e9b-a7aa-f52eb24889b3">
      <Text>Dash Logistics </Text>
      <Text AdornmentStyle="-1">TVC</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d7fb3791-32e8-4044-b6d5-8ccdacd2d9f8">
      <Text>Final Draft Script Based on Storyboard</Text>
    </Paragraph>
    <Paragraph Type="Action" id="73b8b8d0-899a-458f-a372-69f688a4ed04">
      <Text>Duration: </Text>
      <Text AdornmentStyle="-1">Approx</Text>
      <Text>. 25–45 seconds | Format: No Dialogue / Emotional Advertisement</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="a3cd5508-79b2-4992-9fb9-a7c1084067a0">
      <Text>FADE IN:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="3028f288-3100-4af0-be53-379646e3768e">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MOTHER'S ROOM - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" id="78352a2d-524f-4799-ab19-32c5b2eb0a0d">
      <Text>SCENE 1 — 1 TO 2 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cc3f2031-c4c0-4ac5-a66a-65ac989e2879">
      <Text>Close-up of a MOTHER'S hands carefully placing folded clothes inside a red Dash package box.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bd6d1714-705b-418b-af97-37d07093cbf5">
      <Text>The movement is slow and gentle, showing care.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5f8d53dd-b44b-4147-8ac5-59f9fd34caf2">
      <Text>Soft emotional music begins.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a67387ec-0c52-4eef-b8ab-c928e712074b"/>
    <Paragraph Type="Scene Heading" id="74a92fd0-4c93-486b-8bca-6cd90352538b">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. MOTHER'S ROOM - CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="391d4d7c-494f-41af-8613-4fe12cddcd11">
      <Text>SCENE 2 — 2 TO 6 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="77199cfd-f928-4181-9a60-6957244bc510">
      <Text>The mother adds homemade food inside the box.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="71aaad6e-ce41-4b69-94c5-9450101488b4">
      <Text>She places a handwritten letter on top of the clothes and food.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9276cd7e-b64c-4902-b9a9-36f65a012355">
      <Text>The note becomes the emotional focus of the package.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eb4c27e0-f1b9-4baf-a4b7-8759f570fd54"/>
    <Paragraph Type="Scene Heading" id="5fc57993-06c1-4591-8760-5bbeb418d6a9">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. HOUSE ENTRANCE - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ae75b3e9-9055-43be-93c8-3fbd20d44361">
      <Text>SCENE 3 — 2 TO 3 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea233147-e90f-4977-8200-86ff06ba50dc">
      <Text>A DASH RIDER waits outside the house.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c3b08399-cd61-495e-899b-1c1f198b84b3">
      <Text>The mother hands over the package to the rider.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c2b0bc49-c1a1-45ec-96c3-809f2ec23e81">
      <Text>The rider receives it carefully.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a2941a80-8232-49d3-9228-d039b1c5c015">
      <Text>The mother watches with a soft expression as the package leaves her hands.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="6b55d169-2a38-47f1-bedd-c8fea80c6a27">
      <SceneProperties Length="2/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>EXT. STREET / ROAD - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5614c637-4129-4837-ab72-3ed09f15630c">
      <Text>SCENE 4 — 5 TO 15 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c171dee3-09f1-4d16-b466-c0ad32fdc39f">
      <Text>The Dash rider rides through the road on a scooter.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a9c57f9e-4c59-4de1-b278-7acd1f4bed9a">
      <Text>The red Dash delivery bag is visible.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b89d1410-8e9a-4448-9cd6-38da9db7af6b">
      <Text>The scooter moves through local streets, showing the delivery journey from the mother's place to the son's location.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7580eaa8-56ce-4598-b628-580f94a6d3cd">
      <Text>The music slowly builds.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="74ff2270-b180-4c81-a0f4-2cdc011757a7"/>
    <Paragraph Type="Scene Heading" id="6c59d89d-4d0e-4e38-bc47-6ef10164b355">
      <SceneProperties Length="2/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. SON'S PLACE / DOORWAY - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bf939c7-668b-4d5b-a2b2-0b1f1ba3f552">
      <Text>SCENE 5 — 2 TO 6 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bc1fd873-65d1-4309-b329-e5fd1134df06">
      <Text>The package arrives at the son's place.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="961d939a-a399-4ba0-b5f5-4e2b927d0852">
      <Text>The son opens the door.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="636c8ed3-626e-485c-ac23-50dfbcaae2cc">
      <Text>The Dash rider hands him the package.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c5ed335f-0649-4d87-a725-a34280ffe8a9">
      <Text>The son receives it with curiosity and a small smile.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0a234255-8b47-40f5-8837-5e7485c05f0a"/>
    <Paragraph Type="Scene Heading" id="87f7fbb2-aaed-4be7-8eed-1855f4ceb307">
      <SceneProperties Length="2/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. SON'S ROOM - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" id="68cc633a-ab94-42bb-a916-cf339b1b3b67">
      <Text>SCENE 6 — 2 TO 3 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="27809352-852c-4a02-930b-50dcf0ef6954">
      <Text>The son sits down and opens the package.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0ff0d584-99ab-4877-8a9b-ef59e4644403">
      <Text>He sees the clothes and food inside.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="67661e85-fa9f-4864-96c2-033d3899ad99">
      <Text>His attention moves toward the handwritten note.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d289970e-15df-4e84-b9f8-56448e36d5f8"/>
    <Paragraph Type="Scene Heading" id="9bd71b4d-db36-46cb-9671-57b50b62d356">
      <SceneProperties Length="5/8" Page="2" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>INT. SON'S ROOM - CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a4254d46-97f2-473c-ab20-f7f8945328d2">
      <Text>SCENE 7 — 3 TO 5 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e774d6b4-575b-4357-8245-3ea0160b6596">
      <Text>Close-up of the son holding the note.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4d9b5db9-db61-4262-a44c-2ecbabac20c6">
      <Text>He reads it silently.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9a7721d7-4cd7-45c4-81f5-6d24a6e66a5b">
      <Text>His face slowly changes from curiosity to emotion.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b77f82ba-7594-4500-85be-06c188c1d624">
      <Text>He smiles softly, feeling connected to home.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="08ff0aff-2b91-45b5-a52b-64031c2ef8a5">
      <Text>CUT TO BLACK:</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7b0cd5d2-b03b-44d9-a0f0-ce22d945bb59">
      <Text>SCENE 8 — 2 TO 5 SECONDS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5c6a18db-22b5-4b8f-9598-b0f45385567a">
      <Text>ON SCREEN TEXT:</Text>
    </Paragraph>
    <Paragraph Type="Action" id="35976db6-2437-4239-9b4f-ec6e7599225c">
      <Text>Distance doesn't break bonds.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3e8e4967-2dae-4f45-adf0-2104d6d612c2">
      <Text>Dash delivers what matters.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="afd71683-26ee-481e-a184-bb705901be8f">
      <Text>DASH LOGISTICS LOGO APPEARS.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="363572aa-55ec-403c-81ad-2de302635046">
      <Text>Soft music fades out.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="33706dbb-2e1a-4753-ac6e-441004d1e2ea">
      <Text>FADE OUT.</Text>
    </Paragraph>
  </Content>

